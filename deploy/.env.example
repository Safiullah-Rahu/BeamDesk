# Your domain, pointing (DNS A/AAAA record) at this server.
DOMAIN=desk.example.com

# Shared secret between the BeamDesk server and the TURN relay.
# Generate one with:  openssl rand -hex 32
TURN_SECRET=change-me-to-a-long-random-string

# Optional: require this key in every app (Settings -> Network) to keep your server private.
ACCESS_KEY=

# Optional: shown in the apps.
SERVER_NAME=BeamDesk

# Optional: only if auto-detection picks the wrong public IP (e.g. some cloud NATs).
TURN_EXTERNAL_IP=
